# Copy to .env.local and adjust. .env.local is gitignored.

# --- Local Supabase (npm run db:start) --------------------------------------
# These values are identical for every developer's local stack and are printed
# by `npx supabase status`. They are NOT secrets and do not work against any
# hosted project. Keep them as they are for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Service role (tests only) --------------------------------------------
# Read ONLY by src/adapters/supabase/service-role.client.ts, which only the
# Playwright setup (e2e/) may import. It bypasses Row Level Security and must
# never serve a user request. The value below is the public local demo key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- Hosted Supabase (Project Settings -> API) ------------------------------
# For a deployed environment replace the two values above with the project's
# own URL and anon key. Never commit those.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
